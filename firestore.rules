rules_version = '2';

// ============================================================
// Firestore rules for the timed-exam backend (student accounts).
// Paste into Firebase console → Firestore Database → Rules.
// 1. Replace elrwenyahmed05@gmail.com with YOUR teacher email
//    (create that user FIRST in Authentication → Users, so no
//    student can register it afterwards).
// 2. Publish. Also enable Google provider in
//    Authentication → Sign-in method.
//
// What this enforces on the SERVER (cannot be bypassed by
// editing page code):
// - Accounts: anyone signed in can create ONLY their own
//   profile (uid must match, email must match the login).
// - One attempt per account: attempt docs are bound to the
//   owner's uid (doc id ends with it) and only `create` is
//   allowed — a second submit is rejected automatically.
// - Only email+password or Google accounts (students/teacher) can
//   submit. Anonymous visitors can only read the exam config.
// - Students can read ONLY their own attempt; they can NEVER
//   list the roster, change config, or delete anything.
// - Only the signed-in teacher can read the roster, change
//   config, or delete attempts.
// - Submitted scores are range-validated (0..total).
// ============================================================

service cloud.firestore {
  match /databases/{db}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'elrwenyahmed05@gmail.com';
    }

    function isAccount() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'password'
          || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function validAttempt(docId) {
      return request.resource.data.owner is string
        && request.resource.data.owner == request.auth.uid
        && docId.matches('.*_' + request.auth.uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.score is int
        && request.resource.data.total is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.pct is int
        && request.resource.data.pct >= 0
        && request.resource.data.pct <= 100
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 60;
    }

    // Student profiles: owner creates + reads own, teacher reads.
    match /users/{uid} {
      allow get: if isTeacher()
        || (request.auth != null && request.auth.uid == uid);
      allow list: if isTeacher();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;
      allow update, delete: if isTeacher();
    }

    // Shared exam config: everyone reads, teacher writes.
    match /config/{examId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Attempts: one per account, self-read, teacher roster.
    match /attempts/{docId} {
      allow get: if isTeacher()
        || (request.auth != null && resource.data.owner == request.auth.uid);
      allow list: if isTeacher();
      allow create: if isAccount() && validAttempt(docId);
      allow update, delete: if isTeacher();
    }
  }
}
